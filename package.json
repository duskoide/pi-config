    "@mrclrchtr/supi-web": "4.7.0",
    "pi-undo-redo": "0.1.1",
    "@arvoretech/pi-kiro-provider": "0.8.5",
    "@upstash/context7-pi": "0.1.2",
    "pi-simplify": "0.2.3",
    "@gotgenes/pi-permission-system": "24.0.0",
    "pi-agent-browser-native": "0.3.0",
    "@ogulcancelik/pi-codex-compaction": "0.1.3",
    "@ff-labs/pi-fff": "0.10.5",
    "@xynogen/pix-pretty": "1.17.0",
    "@plannotator/pi-extension": "0.27.6",
    "pi-mcp-adapter": "2.27.0",
    "@gaodes/pi-graphify": "0.2.2",
    "pi-redact-all": "0.1.7",
    "pi-herdr-sudo-task": "0.1.5",
    "pi-antigravity": "0.4.1"
