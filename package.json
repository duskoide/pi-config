{
  "name": "pi-config",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Pi package — all extensions, skills, prompts, and config in one place",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions",

      "./node_modules/pi-commandcode-provider/index.ts",
      "./node_modules/@ogulcancelik/pi-herdr/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts",
      "./node_modules/@juicesharp/rpiv-todo/index.ts",
      "./node_modules/@juicesharp/rpiv-web-tools/index.ts",
      "./node_modules/@mrclrchtr/supi-web/src/extension.ts",
      "./node_modules/pi-undo-redo/src/extension.ts",
      "./node_modules/@arvoretech/pi-kiro-provider/dist/index.js",
      "./node_modules/@upstash/context7-pi/extensions",
      "./node_modules/pi-simplify/dist/index.js",
      "./node_modules/@gotgenes/pi-permission-system/src/index.ts",
      "./node_modules/pi-agent-browser-native/dist/extensions/agent-browser/index.js",
      "./node_modules/@ogulcancelik/pi-codex-compaction/index.ts",
      "./node_modules/@ff-labs/pi-fff/src/index.ts",
      "./node_modules/@xynogen/pix-pretty",
      "./node_modules/@plannotator/pi-extension/",
      "./node_modules/pi-mcp-adapter/index.ts",
      "./node_modules/@gaodes/pi-graphify/src/tools/index.ts",
      "./node_modules/@gaodes/pi-graphify/src/commands/index.ts",
      "./node_modules/pi-redact-all/dist/index.js",
      "./node_modules/pi-herdr-sudo-task/dist/index.js",
      "./node_modules/pi-antigravity/src/index.ts",

      "./pi-herdr-worker/extensions"
    ],
    "skills": [
      "./skills",

      "./node_modules/@upstash/context7-pi/skills",
      "./node_modules/pi-mcp-adapter/skills",
      "./node_modules/@gaodes/pi-graphify/skills",

      "./pi-herdr-worker/skills"
    ],
    "prompts": [
      "./node_modules/@upstash/context7-pi/prompts"
    ]
  },
  "dependencies": {
    "pi-commandcode-provider": "0.5.0",
    "@ogulcancelik/pi-herdr": "0.4.0",
    "@juicesharp/rpiv-ask-user-question": "2.4.0",
    "@juicesharp/rpiv-todo": "2.4.0",
