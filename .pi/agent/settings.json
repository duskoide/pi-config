    "commandcode/deepseek/deepseek-v4.1-flash",
    "deepseek/deepseek-flash",
    "tokenharbor/deepseek-v4-flash",
    "tokenharbor/glm-5.3-flash",
    "atria-asi/Atria-Dawn-Preview",
    "devin/swe-1-6-slow"
