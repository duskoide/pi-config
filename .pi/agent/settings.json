{
  "lastChangelogVersion": "0.85.1",
  "theme": "dark",
  "packages": [
    "npm:@pi-archimedes/image-paste@2.5.1",
    "npm:pi-subagents@0.66.0",
    "npm:pi-antigravity@0.7.2",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:@upstash/context7-pi@0.1.2",
    "npm:pi-redact-all@0.2.1",
    "npm:pi-undo-redo@0.1.1",
    "npm:pi-herdr-sudo-task@0.1.5",
    "npm:@gaodes/pi-graphify@0.2.2",
    "npm:pi-gpt-enhance@0.3.0",
    "npm:@hk_net/pi-usage-bars@0.6.0",
    "npm:@juicesharp/rpiv-ask-user-question@2.9.0",
    "npm:@juicesharp/rpiv-todo@2.9.0",
    "npm:@juicesharp/rpiv-web-tools@2.9.0",
    "npm:@juicesharp/rpiv-advisor@2.9.0",
    "npm:@juicesharp/rpiv-btw@2.9.0",
    "npm:pi-commandcode-provider@0.6.4",
    "npm:pi-powerline-footer@0.17.0",
    "npm:pi-intercom@0.13.0",
    "./pi-config"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "terminal": {
    "showTerminalProgress": true
  },
  "defaultProjectTrust": "always",
  "quietStartup": true,
  "enabledModels": [
    "deepseek/deepseek-v4-flash-vision-exp",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-6-astra",
    "antigravity/gemini-3.7-flash",
    "antigravity/claude-opus-4-6",
    "llama.cpp/tiel-coder-35b",
    "commandcode/z-ai/glm-5.3-flash",
    "commandcode/Qwen/Qwen3.8-Flash"
  ],
  "tuiMode": "fullscreen",
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "max",
    "agentOverrides": {
      "scout": {
        "model": "llama.cpp/tiel-coder-35b",
        "thinking": "high"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "worker": {
        "model": "llama.cpp/tiel-coder-35b",
        "thinking": "max"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "max"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "advisor": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "low"
      }
    }
  },
  "fullscreenCopyOnSelect": true,
  "fullscreenExitOutput": "transcript",
  "treeFilterMode": "default",
  "doubleEscapeAction": "tree",
  "collapseChangelog": true,
  "showCacheMissNotices": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "httpIdleTimeoutMs": 0,
  "outputPad": 1
}
