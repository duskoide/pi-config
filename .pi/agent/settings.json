{
  "lastChangelogVersion": "1.5.0",
  "theme": "noctalia",
  "packages": [
    "npm:@pi-archimedes/image-paste",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:pi-undo-redo@0.1.1",
    "npm:@hk_net/pi-usage-bars",
    "npm:@juicesharp/rpiv-btw",
    "./pi-config",
    "npm:pi-advisor-flow",
    "npm:@zhushanwen/pi-ask-user",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-web-access",
    "npm:pi-cache-optimizer",
    "npm:pi-powerline-footer",
    "npm:@monotykamary/pi-vcc",
    "git:github.com/duskoide/pi-profiles",
    "https://github.com/earendil-works/pi-claude-code"
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "defaultProjectTrust": "always",
  "quietStartup": true,
  "enabledModels": [
    "deepseek/deepseek-flash",
    "claude-code/claude-opus-5-5",
    "claude-code/claude-sonnet-5-5",
    "claude-code/claude-haiku-5-5"
  ],
  "tuiMode": "fullscreen",
  "fullscreenCopyOnSelect": true,
  "fullscreenExitOutput": "resume-hint",
  "treeFilterMode": "default",
  "doubleEscapeAction": "none",
  "collapseChangelog": true,
  "showCacheMissNotices": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "httpIdleTimeoutMs": 0,
  "idleCompact": {
    "enabled": true,
    "minutes": 10,
    "minTokens": 50000
  },
  "undoRedo": {
    "gitTimeoutMs": 5000
  },
  "outputPad": 1,
  "extensions": [
    "-builtin:mcp"
  ],
  "deviceId": "59baa6d9-2444-4ce8-b064-f70897860bda",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-luna",
    "defaultThinking": "max",
    "agentOverrides": {
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "advisor": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "low"
      }
    }
  },
  "modelThinkingLevels": {
    "anthropic/claude-sonnet-5-5": "medium",
    "anthropic/claude-haiku-5-5": "high",
    "anthropic/claude-opus-5-5": "medium",
    "deepseek/deepseek-flash": "high"
  },
  "codemode": {
    "mode": "on"
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@hk_net/pi-usage-bars\",\"scope\":\"user\"}": "0.7.1",
    "{\"source\":\"npm:@gotgenes/pi-anthropic-auth\",\"scope\":\"user\"}": "3.4.4",
    "{\"source\":\"npm:pi-advisor-flow\",\"scope\":\"user\"}": "0.14.4",
    "{\"source\":\"npm:@tintinweb/pi-tasks\",\"scope\":\"user\"}": "0.9.1",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-powerline-footer\",\"scope\":\"user\"}": "0.22.0"
  }
