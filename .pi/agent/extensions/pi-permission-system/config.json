{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": true,
  "permissionReviewLog": true,
  "yoloMode": true,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git *": "allow",
      "bash -c *": "ask",
      "sh -c *": "ask",
      "dash -c *": "ask",
      "zsh -c *": "ask",
      "ksh -c *": "ask",
      "eval *": "ask",
      "rm *": "ask",
      "shred *": "ask",
      "dd *": "ask",
      "mkfs *": "ask",
      "wipefs *": "ask",
      "fdisk *": "ask",
      "gdisk *": "ask",
      "parted *": "ask",
      "sfdisk *": "ask",
      "sudo *": "ask",
      "doas *": "ask",
      "su *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chgrp *": "ask",
      "reboot": "ask",
      "shutdown *": "ask",
      "poweroff": "ask",
      "halt": "ask",
      "systemctl *": "ask",
      "service *": "ask",
      "mount *": "ask",
      "umount *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "useradd *": "ask",
      "userdel *": "ask",
      "usermod *": "ask",
      "groupadd *": "ask",
      "groupdel *": "ask",
      "passwd *": "ask",
      "visudo *": "ask",
      "crontab *": "ask",
      "npm publish *": "ask",
      "pnpm publish *": "ask",
      "yarn publish *": "ask",
      "docker system prune *": "ask",
      "kubectl delete *": "ask",
      "terraform destroy *": "ask",
      "helm uninstall *": "ask"
    }
  }
}
