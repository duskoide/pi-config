# Pi runtime state (regenerated; never commit)

# Credentials and provider auth
auth.json

# Caches and generated catalogs
*.cache.json
models-store.json
*-models.json

# Sessions, state, logs, and generated data
sessions/
state/
agent/sessions/
agent/memory/
agent/state/
agent/missions/
agent/npm/
agent/output/
agent/run-history.jsonl
agent/usage-cache.json
agent/commandcode-models.json
agent/extensions/herdr-agent-state.ts
output/
*.log
provider-failover-state.json

# Machine-local trust decisions
trust.json

# Runtime-only extension settings and data
extensions/*/logs/
**/.venv/
.ready
.gcc_lib_path

# Project-scoped Pi/subagent runtime data
.pi/npm/
.pi/subagents/
.pi/subagentura-state.json
subagentura-state.json

# Dependency trees regenerated by npm
**/node_modules/
